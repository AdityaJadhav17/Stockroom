  "cards": [
    {
      "dot": "cyan",
      "title": "Roles and validation",
      "items": [
        "A purchase is one item and a whole-number quantity from 1 to 10,000.",
        "Member accounts that also hold Manager cannot create purchases.",
        "Services obtain role membership from SQLite and trim reasons to a maximum of 500 characters."
      ]
    },
    {
      "dot": "emerald",
      "title": "Receipt is the stock-changing transition",
      "items": [
        "Approval authorizes a purchase; it does not mean the delivery has arrived.",
        "Receipt claims Approved -> Received, adds quantity and saves audit records in one transaction.",
        "A repeated receipt cannot claim the row, and a filtered unique index also prevents a second Receipt movement."
      ]
    },
    {
      "dot": "violet",
      "title": "Stock issues are a separate operation",
      "items": [
        "A Manager can issue existing inventory without changing a purchase request status.",
        "The conditional subtraction requires enough stock; a negative Issue movement commits with it.",
        "An excessive issue is refused with stock and history unchanged. See StockService.IssueAsync in the runtime map."
      ]
    },
    {
      "dot": "rose",
      "title": "No hidden transitions",
      "items": [
        "This release has no cancellation, reopening or partial receipt.",
        "Busy retries that run out return a controlled retry message.",
        "Other database failures require reopening the record before retrying because commit outcome can be unknown."
      ]
    }
  ]
