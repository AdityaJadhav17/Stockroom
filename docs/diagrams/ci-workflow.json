  "cards": [
    {
      "dot": "cyan",
      "title": "Parallel where the workflow permits",
      "items": [
        "After structure checks, the audit and build are independent jobs.",
        "Integration expands into Ubuntu and Windows, giving seven jobs in total.",
        "Browser tests wait for the entire integration matrix, not only the Linux run."
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence and cleanup",
      "items": [
        "Integration reports and browser failure diagnostics are uploaded even after test failure.",
        "Test artifacts expire after 14 days; each browser test uses disposable data.",
        "The unit project is a scaffold and has no CI test job."
      ]
    },
    {
      "dot": "rose",
      "title": "CI is not deployment or branch protection",
      "items": [
        "CI Status runs even if an upstream job fails, skips or is cancelled.",
        "This workflow has no deployment, release publishing or narrated-demo step.",
        "Requiring CI Status before merge is a separate GitHub repository setting."
      ]
    }
  ]
