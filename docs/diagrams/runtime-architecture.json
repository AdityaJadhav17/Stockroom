  "cards": [
    {
      "dot": "cyan",
      "title": "One application, two roles",
      "items": [
        "Server-rendered Razor Pages and a same-origin stylesheet.",
        "Members request supplies; Managers review, receive and issue.",
        "Inventory reads use AppDbContext; request/history visibility lives in services."
      ]
    },
    {
      "dot": "emerald",
      "title": "Stock and audit commit together",
      "items": [
        "Receipt claims Approved -> Received before increasing stock.",
        "Issue subtracts only where Quantity >= issued; history joins the transaction.",
        "The receipt index permits one Receipt movement per request."
      ]
    },
    {
      "dot": "rose",
      "title": "Security and operating limits",
      "items": [
        "Identity stamps are checked on each authenticated request; logout revokes all account sessions.",
        "Busy errors return a retry message. Other database failures require checking the record before retrying.",
        "This is a local demonstration. Public hosting, HTTPS enforcement and paging remain follow-up work."
      ]
    }
  ]
