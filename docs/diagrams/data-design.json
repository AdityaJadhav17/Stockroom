  "cards": [
    {
      "dot": "cyan",
      "title": "Read the arrows as foreign keys",
      "items": [
        "Each arrow points from a record to the record it references.",
        "An item has many requests and stock movements; a request has many events.",
        "Requester is required; reviewer and receiver are populated by the transition."
      ]
    },
    {
      "dot": "emerald",
      "title": "Receipt and stock invariants",
      "items": [
        "Receipt requires a purchase-request reference, with a filtered unique index.",
        "Issue requires a non-blank reason; stored movement delta cannot be zero.",
        "Services enforce permitted transitions, signs and sufficient stock; database checks are an additional safeguard."
      ]
    },
    {
      "dot": "violet",
      "title": "History is a read model",
      "items": [
        "Created events display the original request reason through the history query.",
        "Members see their own request events; Managers also see stock movements.",
        "The History page exposes no edit or delete handlers. Records are not a cryptographically immutable ledger."
      ]
    }
  ]
