@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var isManager = User.IsInRole(Roles.Manager);
}

<h1>Dashboard</h1>
<p>You are signed in as <strong>@User.Identity?.Name</strong> with the <strong>@(isManager ? Roles.Manager : Roles.Member)</strong> role.</p>

<h2>Low stock</h2>
@if (Model.LowStock.Count == 0)
{
    <p>No items are at or below their reorder threshold.</p>
}
else
{
    <table>
        <caption>Items at or below their reorder threshold</caption>
        <thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Threshold</th></tr></thead>
        <tbody>
            @foreach (var item in Model.LowStock)
            {
                <tr><td>@item.Name</td><td>@DisplayFormat.Quantity(item.Quantity, item.Unit)</td><td>@item.ReorderThreshold</td></tr>
            }
        </tbody>
    </table>
}

<h2 id="pending-heading">@(isManager ? "Pending requests" : "Your pending requests")</h2>
@if (Model.Pending.Count == 0)
{
    <p>No requests are waiting for review.</p>
}
else
{
    ViewData["TableLabel"] = "pending-heading";
    <partial name="_RequestTable" model="Model.Pending" />
}
