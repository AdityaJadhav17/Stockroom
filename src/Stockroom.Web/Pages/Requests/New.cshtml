@page
@model Stockroom.Web.Pages.Requests.NewModel
@{
    ViewData["Title"] = "Request a purchase";
}

<div class="page-head">
    <div>
        <h1>Request a purchase</h1>
        <p class="lead">A manager reviews each request. Stock changes only when an approved delivery is recorded.</p>
    </div>
</div>

<div class="card form-card">
    <form method="post" class="form" novalidate>
        @* Rendered only with errors: when valid, the tag helper emits an inline style that the CSP blocks. *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="error-summary" role="alert"></div>
        }
        <div class="field">
            <label asp-for="Input.ItemId">Item</label>
            <select asp-for="Input.ItemId" asp-items="Model.Items" aria-describedby="item-error" aria-invalid="@FormState.Invalid(ViewData.ModelState, "Input.ItemId")">
                <option value="0">Select an item</option>
            </select>
            <span asp-validation-for="Input.ItemId" id="item-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Quantity">Quantity</label>
            <input asp-for="Input.Quantity" type="number" min="1" max="@PurchaseRules.MaxQuantity" step="1" inputmode="numeric" aria-describedby="quantity-hint quantity-error" aria-invalid="@FormState.Invalid(ViewData.ModelState, "Input.Quantity")">
            <span id="quantity-hint" class="hint">Whole units from 1 to @PurchaseRules.MaxQuantity.ToString("N0"), in the item's unit.</span>
            <span asp-validation-for="Input.Quantity" id="quantity-error" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Reason">Reason</label>
            <textarea asp-for="Input.Reason" rows="4" maxlength="@PurchaseRules.MaxReasonLength" aria-describedby="reason-hint reason-error" aria-invalid="@FormState.Invalid(ViewData.ModelState, "Input.Reason")"></textarea>
            <span id="reason-hint" class="hint">Say what the items are for. Up to @PurchaseRules.MaxReasonLength characters.</span>
            <span asp-validation-for="Input.Reason" id="reason-error" class="field-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit">Submit request</button>
            <a asp-page="/Inventory/Index">Cancel</a>
        </div>
    </form>
</div>
