<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Stockroom</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
        <span class="brand">Stockroom</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="Main">
                <a asp-page="/Index">Dashboard</a>
                <a asp-page="/Inventory/Index">Inventory</a>
                <a asp-page="/Requests/Index">Requests</a>
            </nav>
            <form method="post" asp-page="/Account/Logout" class="signout">
                <span>@User.Identity.Name</span>
                <button type="submit">Log out</button>
            </form>
        }
    </header>
    <main id="main">
        @if (TempData["Message"] is string message)
        {
            <p class="notice" role="status">@message</p>
        }
        @if (TempData["Error"] is string error)
        {
            <p class="notice error" role="alert">@error</p>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        Fictional campus makerspace. All data is synthetic. Times are shown in UTC.
    </footer>
</body>
</html>
